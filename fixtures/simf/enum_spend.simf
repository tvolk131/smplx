fn checksig(pk: Pubkey, sig: Signature) {
    let msg: u256 = jet::sig_all_hash();
    jet::bip_0340_verify((pk, msg), sig);
}

fn inherit_spend(sig: Signature) {
    checksig(param::PUBLIC_KEY, sig);
}

fn cold_spend(cold_sig: Signature) {
    checksig(param::PUBLIC_KEY, cold_sig);
}

fn hot_spend(hot_sig: Signature) {
    checksig(param::PUBLIC_KEY, hot_sig);
}

enum Action {
    Inherit(Signature),
    Cold(Signature),
    Hot(Signature),
}

fn main() {
    match witness::ACTION {
        Action::Inherit(sig: Signature) => inherit_spend(sig),
        Action::Cold(sig: Signature) => cold_spend(sig),
        Action::Hot(sig: Signature) => hot_spend(sig),
    }
}
